{
  "name": "momentum-app",
  "version": "0.1.0",
  "private": true,
  "description": "Momentum — small-group accountability and personal growth PWA",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "auth:check": "node scripts/check-neon-auth-config.mjs"
  },
  "dependencies": {
    "@neon/auth": "0.8.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.0.0",
    "better-auth": "1.7.24",
    "next": "^16.4.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^31.0.1",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.34.9"
}
