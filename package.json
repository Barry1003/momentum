{
  "name": "momentum-app",
  "version": "0.1.0",
  "private": true,
  "description": "Momentum \u2014 small-group accountability and personal growth PWA",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
