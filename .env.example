# Momentum environment template. Never commit actual secrets.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Neon Console > Better Auth > connection/auth URL
NEON_AUTH_BASE_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth"
# Generate: openssl rand -base64 32 (keep private; at least 32 characters)
NEON_AUTH_COOKIE_SECRET=""

# Full app origin, without /api/auth or an onboarding path
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Managed Google OAuth uses Neon's configured shared keys for development.
# Do not set GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET in Momentum.
# Do not set BETTER_AUTH_URL; there is no self-hosted auth server.
