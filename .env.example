# Momentum — Neon-managed authentication (development values only).
# Copy to .env.local and NEVER commit live secrets.
#
# Neon project > Auth > copy Auth URL. This is NOT DATABASE_URL.
NEON_AUTH_BASE_URL=""
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Neon SQL database for squad, profile, goals, tasks and habits.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Application URL, not an authentication provider credential.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google provider and email delivery are configured in the Neon Auth console.
# No GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BETTER_AUTH_SECRET or
# RESEND_API_KEY are required in this Next.js application's env.
