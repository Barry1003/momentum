generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
  ownedSquads   Squad[]           @relation("SquadOwner")
  squadMemberships SquadMember[]
  invitationsCreated SquadInvitation[] @relation("InvitationCreator")
  avatar        Avatar?
  goalsOwned Goal[] @relation("GoalOwner")
  goalMemberships GoalMember[]
  tasksOwned Task[] @relation("TaskOwner")
  tasksAssigned Task[] @relation("TaskAssignee")
  taskCompletions TaskCompletion[]
  habits Habit[]
  habitLogs HabitLog[]
  xpEvents XpEvent[]
  focusSessions FocusSession[]
  checkIns CheckIn[]
  achievements UserAchievement[]
  settings UserSettings?
  accountRequests AccountRequest[]
  accountDeletion AccountDeletion?
  cheersSent Cheer[] @relation("CheerFrom")
  cheersReceived Cheer[] @relation("CheerTo")
  mutes SquadMute[] @relation("MuteBy")
  mutedBy SquadMute[] @relation("MuteOf")
  reportsMade SquadReport[] @relation("ReportBy")
  goalSharePrefs GoalSharePref[]
  notificationCursor NotificationCursor?
  growthStudio GrowthStudio?
  growthReviews GrowthReview[]
  growthEvents GrowthEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model UserProfile {
  userId         String   @id
  displayName    String
  timezone       String   @default("UTC")
  avatarArtStyle String   @default("SOFT_3D")
  onboardingStep String  @default("NAME")
  homePreference String  @default("MY_SPACE")
  onboardingComplete Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}


enum SquadRole {
  OWNER
  ADMIN
  MEMBER
}

enum SquadMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum SquadStatus {
  ACTIVE
  ARCHIVED
}

enum InvitationStatus {
  OPEN
  CLOSED
  EXPIRED
}

model Squad {
  id          String    @id @default(cuid())
  name        String
  description String?
  ownerId     String
  maxMembers  Int       @default(10)
  status      SquadStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User @relation("SquadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     SquadMember[]
  invitations SquadInvitation[]
  goals Goal[]
  tasks Task[]
  sharedHabits Habit[]

  @@index([ownerId])
  @@map("squad")
}

model SquadMember {
  id        String @id @default(cuid())
  squadId   String
  userId    String
  role      SquadRole @default(MEMBER)
  status    SquadMemberStatus @default(ACTIVE)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  squad     Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([squadId, userId])
  @@index([userId, status])
  @@index([squadId, status])
  @@map("squad_member")
}

model SquadInvitation {
  id          String @id @default(cuid())
  squadId     String
  createdById String
  codeHash    String @unique
  email       String?
  expiresAt   DateTime
  maxUses     Int @default(1)
  uses        Int @default(0)
  status      InvitationStatus @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  squad       Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  createdBy   User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([squadId, status])
  @@index([expiresAt])
  @@map("squad_invitation")
}

enum AvatarArtStyle {
  ANIME
  SOFT_3D
}
enum AvatarBodyForm {
  BOY
  GIRL
}
enum AvatarGrowthStage {
  CHILD
  PRETEEN
  TEEN
  YOUNG_ADULT
  ADULT
}

model Avatar {
  id String @id @default(cuid())
  userId String @unique
  name String @default("Ari")
  artStyle AvatarArtStyle @default(ANIME)
  bodyForm AvatarBodyForm @default(BOY)
  stage AvatarGrowthStage @default(CHILD)
  totalXp Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatar")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}
enum GoalSource {
  MANUAL
  GROWTH_STUDIO
}
enum GoalMemberRole {
  EDITOR
  VIEWER
}
enum TaskVisibility {
  PRIVATE
  SQUAD
}
enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
}
enum TaskQuadrant {
  DO
  PLAN
  RECONSIDER
  LEAVE
}

model Goal {
  id          String @id @default(cuid())
  ownerId     String
  squadId     String?
  title       String
  why         String?
  area        String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime? @db.Date
  completedAt DateTime?
  source      GoalSource @default(MANUAL)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  squad       Squad? @relation(fields: [squadId], references: [id], onDelete: Restrict)
  members     GoalMember[]
  tasks       Task[]
  habits       Habit[]
  milestones  GoalMilestone[]

  @@index([ownerId, status])
  @@index([squadId, status])
  @@map("goal")
}

model GoalMember {
  id        String @id @default(cuid())
  goalId    String
  userId    String
  role      GoalMemberRole @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goal      Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([goalId, userId])
  @@index([userId])
  @@map("goal_member")
}

model Task {
  id            String @id @default(cuid())
  ownerId       String
  assigneeId    String?
  goalId        String?
  squadId       String?
  title         String
  notes         String?
  dueDate       DateTime? @db.Date
  dueTime       String?
  durationMin   Int?
  priority      TaskPriority @default(NONE)
  visibility    TaskVisibility @default(PRIVATE)
  quadrant      TaskQuadrant?
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  assignee      User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  goal          Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  squad         Squad? @relation(fields: [squadId], references: [id], onDelete: Restrict)
  completions   TaskCompletion[]

  @@index([ownerId, dueDate])
  @@index([squadId, dueDate])
  @@index([goalId])
  @@map("task")
}

model TaskCompletion {
  id             String @id @default(cuid())
  taskId         String
  userId         String
  occurrenceDate DateTime @db.Date
  completedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  task           Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([taskId, occurrenceDate])
  @@index([userId, occurrenceDate])
  @@map("task_completion")
}

enum HabitTargetType {
  CHECK
  COUNT
  DURATION
}

enum HabitStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Habit {
  id                String @id @default(cuid())
  ownerId           String
  name              String
  description       String?
  category          String?
  icon              String?
  targetType        HabitTargetType @default(CHECK)
  targetValue       Int @default(1)
  unit              String?
  reminderTime      String?
  scheduleDays      Int[] @default([0, 1, 2, 3, 4, 5, 6])
  startsOn          DateTime? @db.Date
  pausedUntil       DateTime? @db.Date
  goalId            String?
  sharedWithSquadId String?
  status            HabitStatus @default(ACTIVE)
  pausedAt          DateTime?
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  goal              Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  sharedWithSquad   Squad? @relation(fields: [sharedWithSquadId], references: [id], onDelete: SetNull)
  logs              HabitLog[]

  @@index([ownerId, status])
  @@index([sharedWithSquadId])
  @@map("habit")
}

model HabitLog {
  id        String @id @default(cuid())
  habitId   String
  userId    String
  date      DateTime @db.Date
  value     Int
  completed Boolean
  loggedAt  DateTime @default(now())
  revision  Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  habit     Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_log")
}

enum XpSource {
  TASK
  HABIT
  HABIT_MOMENT
  FOCUS
  CHECK_IN
  MILESTONE
  GOAL
  ACHIEVEMENT
  OPENING_BALANCE
  REVIEW
}

enum GrowthEventKind {
  STAGE_UP
  ACHIEVEMENT
}

// An append-only accounting event; negative entries compensate prior awards.
model XpEvent {
  id             String @id @default(cuid())
  userId         String
  source         XpSource
  sourceId       String
  idempotencyKey String
  amount         Int
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, source, sourceId])
  @@map("xp_event")
}

// Private, persistent celebrations. Stage itself is permanent on Avatar.
model GrowthEvent {
  id            String @id @default(cuid())
  userId        String
  kind          GrowthEventKind
  stage         AvatarGrowthStage?
  achievementId String?
  atXp          Int
  acknowledgedAt DateTime?
  createdAt     DateTime @default(now())
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, acknowledgedAt, createdAt])
  @@map("growth_event")
}

enum FocusMode {
  SOLO
  SQUAD
}

// One focus round. The server stamps the start, so credited time can't exceed real time.
model FocusSession {
  id             String    @id @default(cuid())
  userId         String
  clientKey      String
  taskId         String?
  mode           FocusMode @default(SOLO)
  plannedMinutes Int
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  focusedSeconds Int       @default(0)
  verified       Boolean   @default(true)
  xpAwarded      Int       @default(0)
  stopReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientKey])
  @@index([userId, endedAt])
  @@map("focus_session")
}

// One reflection a day. Words stay private; only "checked in" may be shared.
model CheckIn {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  mood           String
  effort         String
  win            String   @default("")
  obstacle       String   @default("")
  shareCheckedIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("check_in")
}

// An achievement a person has earned. Definitions live in code (src/modules/progress/catalog.ts).
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  isShared      Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievement")
}

// Ordered steps toward a goal. The first one not yet reached is the current one.
model GoalMilestone {
  id          String          @id @default(cuid())
  goalId      String
  title       String
  position    Int
  reachedAt   DateTime?
  reachedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  goal        Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  criteria    GoalCriterion[]

  @@index([goalId, position])
  @@map("goal_milestone")
}

model GoalCriterion {
  id          String        @id @default(cuid())
  milestoneId String
  label       String
  done        Boolean       @default(false)
  position    Int
  milestone   GoalMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, position])
  @@map("goal_criterion")
}

// Per-person preferences: what squads may see, reminders, quiet hours and the public handle.
model UserSettings {
  userId                   String   @id
  handle                   String?  @unique
  intention                String   @default("")
  shareCheckedIn           Boolean  @default(true)
  shareFocusStatus         Boolean  @default(true)
  shareFinishedSharedTasks Boolean  @default(true)
  shareGrowthStage         Boolean  @default(true)
  shareStreaksAndXp        Boolean  @default(false)
  morningPlan              Boolean  @default(true)
  morningPlanTime          String   @default("08:30")
  eveningCheckIn           Boolean  @default(true)
  eveningCheckInTime       String   @default("21:00")
  habitReminders           Boolean  @default(true)
  squadCheers              Boolean  @default(false)
  reviewDay                Boolean  @default(true)
  quietEnabled             Boolean  @default(true)
  quietFrom                String   @default("22:00")
  quietTo                  String   @default("08:00")
  quietDays                String   @default("everyDay")
  quietCustomDays          Int[]    @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum AccountRequestKind {
  EMAIL_CHANGE
  DELETE_ACCOUNT
}

// A one-time code for a sensitive account change. Only a hash of the code is stored.
model AccountRequest {
  id         String             @id @default(cuid())
  userId     String
  kind       AccountRequestKind
  codeHash   String
  newEmail   String?
  attempts   Int                @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("account_request")
}

// A scheduled deletion. Nothing is deleted when this is created; it can be cancelled until then.
model AccountDeletion {
  userId       String    @id
  scheduledFor DateTime
  requestedAt  DateTime  @default(now())
  cancelledAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_deletion")
}

// A small, kind message between squadmates. Limited per day so it stays meaningful.
model Cheer {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  squadId    String
  message    String
  momentId   String?
  createdAt  DateTime @default(now())
  from       User     @relation("CheerFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("CheerTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, toUserId, createdAt])
  @@index([toUserId, createdAt])
  @@map("cheer")
}

// Hides one person's cheers and moments from another. The muted person is never told.
model SquadMute {
  id          String   @id @default(cuid())
  userId      String
  mutedUserId String
  createdAt   DateTime @default(now())
  user        User     @relation("MuteBy", fields: [userId], references: [id], onDelete: Cascade)
  muted       User     @relation("MuteOf", fields: [mutedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, mutedUserId])
  @@map("squad_mute")
}

// Private to the Momentum safety team. The reported person is never told.
model SquadReport {
  id             String   @id @default(cuid())
  reporterId     String
  squadId        String
  reportedUserId String?
  reason         String
  details        String   @default("")
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  reporter       User     @relation("ReportBy", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@map("squad_report")
}

// What one member chooses to show on a shared goal.
model GoalSharePref {
  goalId    String
  userId    String
  showCount Boolean  @default(true)
  showNames Boolean  @default(false)
  linkTask  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([goalId, userId])
  @@map("goal_share_pref")
}

// When the person last marked their notifications read. Notifications themselves are built from activity.
model NotificationCursor {
  userId String   @id
  readAt DateTime
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_cursor")
}

// One person's Growth Studio: life audit, reflections and their goal grid. Private to them.
// Stored as validated JSON because it's only ever read and written whole by its owner.
model GrowthStudio {
  userId           String   @id
  areas            Json
  answers          Json
  lastPausedAreaId String?
  grid             Json?
  cycleStartedAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("growth_studio")
}

// A saved 15-day review. One per cycle; saving earns XP once.
model GrowthReview {
  id         String   @id @default(cuid())
  userId     String
  cycle      Int
  obstacles  String[]
  context    String   @default("")
  changes    Json
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cycle])
  @@map("growth_review")
}
